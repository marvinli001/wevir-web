// Cloudflare Workers static assets: no Worker code, only the built files in dist/. Unknown paths (/pair, /computers)
// get index.html; headers come from dist/_headers (public/_headers). Deployed by .github/workflows/web.yml.
{
  "name": "wevir-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "web.wevir.si", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
